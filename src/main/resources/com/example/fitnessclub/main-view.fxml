<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fitnessclub.MainController">
    <children>

        <VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="220.0" spacing="10.0" style="-fx-background-color: #1F1C2C;">
            <padding>
                <Insets top="30.0" left="10.0" right="10.0" />
            </padding>
            <children>
                <Label text="POWER GYM" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </Label>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #3A354E; -fx-text-fill: white; -fx-alignment: BASELINE_LEFT; -fx-padding: 12 20 12 20; -fx-background-radius: 5; -fx-cursor: hand;" text="👥 Клієнти">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #b3b3b3; -fx-alignment: BASELINE_LEFT; -fx-padding: 12 20 12 20; -fx-cursor: hand;" text="💳 Абонементи">
                    <font><Font size="14.0" /></font>
                </Button>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #b3b3b3; -fx-alignment: BASELINE_LEFT; -fx-padding: 12 20 12 20; -fx-cursor: hand;" text="🏋️ Тренування">
                    <font><Font size="14.0" /></font>
                </Button>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #b3b3b3; -fx-alignment: BASELINE_LEFT; -fx-padding: 12 20 12 20; -fx-cursor: hand;" text="💰 Оплати">
                    <font><Font size="14.0" /></font>
                </Button>
            </children>
        </VBox>

        <VBox prefHeight="600.0" prefWidth="680.0" spacing="20.0" style="-fx-background-color: #F4F6F9;" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" prefWidth="200.0">
                    <children>
                        <Label text="Управління клієнтами" textFill="#2f2f2f">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <TextField fx:id="searchField" prefWidth="250.0" promptText="Пошук за ПІБ або телефоном..." style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #cccccc; -fx-padding: 7 15 7 15;" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="addClientButton" mnemonicParsing="false" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 15 8 15; -fx-cursor: hand;" text="+ Додати клієнта">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button fx:id="viewDetailsButton" mnemonicParsing="false" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 15 8 15; -fx-cursor: hand;" text="ℹ️ Картка клієнта">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                    </children>
                </HBox>

                <TableView fx:id="clientTable" prefHeight="200.0" prefWidth="200.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="nameColumn" prefWidth="200.0" text="ПІБ Клієнта" />
                        <TableColumn fx:id="phoneColumn" prefWidth="130.0" text="Телефон" />
                        <TableColumn fx:id="emailColumn" prefWidth="130.0" text="Email" />
                        <TableColumn fx:id="regDateColumn" prefWidth="110.0" text="Дата реєстрації" />
                    </columns>
                </TableView>

            </children>
        </VBox>
    </children>
</HBox>